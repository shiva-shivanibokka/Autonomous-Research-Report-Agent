# ---------------------------------------------------------------------------
# API Keys
# ---------------------------------------------------------------------------
# LLM keys are BYOK (bring your own key) — supplied per-request from the UI and
# never stored. ANTHROPIC_API_KEY here is only the OPTIONAL server-side fallback
# used when a request omits a key (e.g. local dev).
ANTHROPIC_API_KEY=your_anthropic_api_key_here_optional

# Whether a request that carries NO key may spend the key above. Off unless set.
# Leave it off on anything reachable from the internet: the key has to be in the
# environment to record a demo run, and with the fallback on, any visitor who
# omits their own key spends yours instead.
# ALLOW_SERVER_KEY_FALLBACK=true

# Tavily powers web search and is server-side infrastructure (not BYOK). Required.
TAVILY_API_KEY=your_tavily_api_key_here

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins (no trailing slash).
# Include your Vercel URL in production, e.g. https://your-app.vercel.app
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Infrastructure — ALL OPTIONAL. Leave these commented out for a local run.
#
# docker-compose.yml sets its own values for these, so they are only here as a
# reference. Uncommenting them for a local `uvicorn` run is actively harmful:
# `postgres` and `redis` are Compose network aliases that resolve nowhere else,
# so startup blocks on a lookup that can never succeed.
#
# With DATABASE_URL unset, jobs are held in an in-process store — correct rather
# than approximate under the default JOB_BACKEND=inline, where the pipeline runs
# in the same process that serves the status polls. Jobs are lost on restart.
# /health reports which store is live. Set it to a real Postgres URL for durable
# storage, e.g. a free Neon project.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host/dbname
# REDIS_URL=redis://localhost:6379/0

# Job execution: "inline" runs the pipeline in-process (default);
# "celery" dispatches to the worker and requires DATABASE_URL + REDIS_URL.
# JOB_BACKEND=inline

# Ceiling on concurrent in-process pipelines.
# MAX_INLINE_JOBS=4

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Tracing no-ops when OTLP_ENDPOINT is unset — leave it blank unless a collector
# is actually running, or spans queue against an unreachable endpoint.
# OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Alerting (optional — Slack integration)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The Next.js UI reads NEXT_PUBLIC_API_URL from frontend/.env.local, not here.
# See frontend/.env.local.example.
